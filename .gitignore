# ==========================================
# Credenciales y Configuración Sensible
# ==========================================
# Ignorar el archivo real de conexión a BD para no filtrar contraseñas
/app/Config/Database.php
# Ignorar la clave real del buzon de correo (usar Correo.local.ejemplo.php como plantilla)
/app/Config/Correo.local.php
# Ignorar archivos de variables de entorno (si llegamos a usarlos)
.env
.env.*
!.env.example

# ==========================================
# Dependencias de Terceros
# ==========================================
# Ignorar la carpeta vendor generada por Composer (Ej. PHPMailer, DomPDF)
/vendor/

# ==========================================
# Archivos de Logs y Caché
# ==========================================
*.log
/logs/
/cache/
/tmp/

# ==========================================
# Archivos de Base de Datos
# ==========================================
# Ignorar cualquier volcado de BD por accidente...
*.sql
*.sqlite
# ...EXCEPTO el script oficial de instalación que se menciona en el README
!plenamente_bd.sql

# ==========================================
# Respaldos del Sistema (contienen datos clínicos sensibles)
# ==========================================
# Los archivos .sql.gz NO coinciden con *.sql, se ignoran de forma explicita
/backups/*.sql.gz
# ...pero la configuración de protección de la carpeta sí se versiona
!/backups/.htaccess

# ==========================================
# Archivos del Sistema Operativo
# ==========================================
.DS_Store
.DS_Store?
._*
.Trashes
Thumbs.db
ehthumbs.db

# ==========================================
# Configuraciones de Editores de Código (IDE)
# ==========================================
/.vscode/
/.idea/
*.sublime-workspace
*.suo
*.swp